# Chain: 8453 = Base mainnet, 84532 = Base Sepolia
CHAIN_ID=8453

# RPC (optional — defaults to public Base RPC)
RPC_URL=https://mainnet.base.org

# Keeper wallet private key (needs ETH for gas — ~$1/day on Base mainnet)
KEEPER_PRIVATE_KEY=0x...

# Telegram alerts (optional — leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
